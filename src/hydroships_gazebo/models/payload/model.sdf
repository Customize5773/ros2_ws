<?xml version="1.0" ?>
<!-- Catatan: file ini cadangan konsisten dgn PAYLOAD_SDF_TEMPLATE di
     scripts/payload_spawner.py (yang dipakai runtime). Model 'payload' di
     arena di-spawn oleh spawner, bukan dari sini. DetachableJoint yang benar
     hidup di hydroships.urdf.xacro (parent=gripper_base, child=payload) —
     salinan lama di file ini yang membalik parent/child DIHAPUS (dulu
     menyebabkan closed-kinematic-chain segfault). -->
<sdf version="1.9">
  <model name="payload">
    <static>false</static>
    <link name="payload_link">
      <inertial>
        <pose>0 0.000396226 0.034433962 0 0 0</pose>
        <mass>0.3</mass>
        <inertia>
          <ixx>2.51e-4</ixx><iyy>3.13e-4</iyy><izz>6.34e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- shortcut: box approximation of the 30mm bore; use a ring mesh if corner contact accuracy is needed. -->
      <collision name="body_collision">
        <pose>0 -0.003 0.032 0 0 0</pose>
        <geometry><box><size>0.05 0.006 0.064</size></box></geometry>
      </collision>
      <collision name="slot_left_collision">
        <pose>-0.020 -0.003 0.079 0 0 0</pose>
        <geometry><box><size>0.010 0.006 0.030</size></box></geometry>
      </collision>
      <collision name="slot_right_collision">
        <pose>0.020 -0.003 0.079 0 0 0</pose>
        <geometry><box><size>0.010 0.006 0.030</size></box></geometry>
      </collision>
      <collision name="bar_collision">
        <pose>0 -0.003 0.097 0 0 0</pose>
        <geometry><box><size>0.05 0.006 0.006</size></box></geometry>
      </collision>
      <collision name="grip_tab_collision">
        <pose>0 0.012 0.003 0 0 0</pose>
        <geometry><box><size>0.05 0.024 0.006</size></box></geometry>
      </collision>
      <visual name="body_1">
        <geometry>
          <mesh><uri>model://hydroships_gazebo/media/payload_body.obj</uri></mesh>
        </geometry>
        <material>
          <ambient>0.75 0.76 0.80 1</ambient>
          <diffuse>0.82 0.83 0.86 1</diffuse>
        </material>
      </visual>
      <visual name="qr_1">
        <pose>0 0.0012 0.04 0 0 0</pose>
        <geometry><plane><normal>0 1 0</normal><size>0.06 0.06</size></plane></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://hydroships_gazebo/media/qr_A.png</albedo_map>
              <emissive_map>model://hydroships_gazebo/media/qr_A.png</emissive_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <velocity_decay>
        <linear>1.0</linear>
        <angular>1.0</angular>
      </velocity_decay>
    </link>
  </model>
</sdf>
