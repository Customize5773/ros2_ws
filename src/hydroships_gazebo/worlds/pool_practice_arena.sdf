<?xml version="1.0" ?>
<!--
  Kolam latihan 2,2 x 4,4 x 0,8 m (fisik user) untuk Gazebo Fortress / gz-sim 6.

  Sama seperti kki_arena.sdf tapi:
    * Interior 2,2 x 4,4 m (bukan 5x5), dinding di x=+-1.1, y=+-2.2.
    * Kedalaman air 0,8 m (bukan 0,9), sesuai pool_trial.yaml.
    * Hook 4 sisi TETAP dipertahankan (bukan cuma 1 seperti kolam fisik asli)
      supaya jalur "pilih dinding sesuai QR" bisa diuji di sim, lihat
      autonomy/config/pool_trial.yaml (catatan: jalur itu belum teruji di
      kolam fisik krn cuma ada 1 dinding hook di sana).
    * Tip hook di z=-0.415 (bukan -0.45), turunan dari
      hook_height_from_floor=0.385 di pool_trial.yaml, floor di z=-0.8.

  Nama world DIBIARKAN "kki_arena" (sama seperti kki_arena_test.sdf yang juga
  beda file tapi world-name identik); payload_spawner.py hardcode target
  service /world/kki_arena/remove; ganti nama world = penghapusan payload
  lama diam-diam gagal tiap run. Jangan ganti tanpa update payload_spawner.py.

  Datum (konsisten dengan plugin Buoyancy):
    * Permukaan air         : z = 0
    * Dasar kolam (atas)    : z = -0.8  (kedalaman air 0.8 m)
    * Ujung bawah hook (J)  : z = -0.415 (0.385 m dari dasar)
-->
<sdf version="1.9">
  <world name="kki_arena">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-buoyancy-system"
            name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000.0</default_density>
        <density_change>
          <above_depth>0.0</above_depth>
          <density>1.0</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.1 0.2 0.35 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- ================= Cangkang kolam: lantai + 4 dinding ================= -->
    <!-- Interior 2,2 x 4,4 m; muka dalam dinding di x=+-1.1 (sisi pendek),
         y=+-2.2 (sisi panjang). Dinding tebal 0,1 m, tinggi 0,95 m (dari
         dasar -0.8 sampai freeboard +0.15). -->
    <model name="pool">
      <static>true</static>

      <!-- Lantai: permukaan atas di z = -0.8. -->
      <link name="floor">
        <pose>0 0 -0.85 0 0 0</pose>
        <collision name="floor_collision">
          <geometry><box><size>2.3 4.5 0.1</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>2.3 4.5 0.1</size></box></geometry>
          <material>
            <ambient>0.20 0.20 0.22 1</ambient>
            <diffuse>0.30 0.30 0.32 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Dinding +X (pendek, muka dalam di x = 1.1). -->
      <link name="wall_px">
        <pose>1.15 0 -0.325 0 0 0</pose>
        <collision name="wall_px_collision">
          <geometry><box><size>0.1 4.5 0.95</size></box></geometry>
        </collision>
        <visual name="wall_px_visual">
          <geometry><box><size>0.1 4.5 0.95</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.57 1</ambient>
            <diffuse>0.70 0.70 0.72 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Dinding -X (pendek). -->
      <link name="wall_nx">
        <pose>-1.15 0 -0.325 0 0 0</pose>
        <collision name="wall_nx_collision">
          <geometry><box><size>0.1 4.5 0.95</size></box></geometry>
        </collision>
        <visual name="wall_nx_visual">
          <geometry><box><size>0.1 4.5 0.95</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.57 1</ambient>
            <diffuse>0.70 0.70 0.72 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Dinding +Y (panjang, muka dalam di y = 2.2). -->
      <link name="wall_py">
        <pose>0 2.25 -0.325 0 0 0</pose>
        <collision name="wall_py_collision">
          <geometry><box><size>2.3 0.1 0.95</size></box></geometry>
        </collision>
        <visual name="wall_py_visual">
          <geometry><box><size>2.3 0.1 0.95</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.57 1</ambient>
            <diffuse>0.70 0.70 0.72 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Dinding -Y (panjang). -->
      <link name="wall_ny">
        <pose>0 -2.25 -0.325 0 0 0</pose>
        <collision name="wall_ny_collision">
          <geometry><box><size>2.3 0.1 0.95</size></box></geometry>
        </collision>
        <visual name="wall_ny_visual">
          <geometry><box><size>2.3 0.1 0.95</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.57 1</ambient>
            <diffuse>0.70 0.70 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Volume air visual (semi-transparan), tanpa collision. Permukaan di
         z = 0, dasar di z = -0.8. -->
    <model name="water_volume">
      <static>true</static>
      <pose>0 0 -0.4 0 0 0</pose>
      <link name="water_link">
        <visual name="water_visual">
          <geometry><box><size>2.2 4.4 0.8</size></box></geometry>
          <material>
            <ambient>0.0 0.25 0.4 0.25</ambient>
            <diffuse>0.0 0.35 0.5 0.25</diffuse>
          </material>
          <transparency>0.75</transparency>
        </visual>
      </link>
    </model>

    <!-- ================= Payload dgn QR =================
         Tidak didefinisikan inline, di-spawn RUNTIME oleh node
         `payload_spawner` (hydroships_gazebo). Bounds spawn default node itu
         (arena_x_min/max, arena_y_min/max) dikalibrasi utk arena 5x5 m,
         override param itu (ros2 param set / launch arg) saat memakai world
         kolam latihan ini, misal x in [0.2,0.6], y in [-1.5,1.5] tidak cocok
         utk kolam 2,2x4,4; sesuaikan agar tetap dalam bounds x in [-0.9,0.9],
         y in [-2.0,2.0]. -->

    <light type="point" name="payload_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 -0.4 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>3.0</range>
        <constant>0.6</constant>
        <linear>0.15</linear>
        <quadratic>0.08</quadratic>
      </attenuation>
    </light>

    <!-- ============================ Hook / gantungan ============================ -->
    <!--
      Sama seperti kki_arena.sdf tapi riser dipendekkan (0.55 -> 0.515) supaya
      tip hook mendarat di z=-0.415 (bukan -0.45), sesuai kedalaman kolam
      0,8 m ini. Frame lokal: origin di muka dinding, +x masuk kolam, +z atas.
    -->
    <model name="hook_d">
      <static>true</static>
      <pose>-1.1 0 0 0 0 0</pose>
      <link name="gantungan">
        <collision name="mount_collision">
          <pose>0.03 0 0.10 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.06</length></cylinder></geometry>
        </collision>
        <visual name="mount_visual">
          <pose>0.03 0 0.10 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
        <collision name="riser_collision">
          <pose>0.06 0 -0.1575 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.515</length></cylinder></geometry>
        </collision>
        <visual name="riser_visual">
          <pose>0.06 0 -0.1575 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.515</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
        <collision name="bottom_collision">
          <pose>0.10 0 -0.415 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.08</length></cylinder></geometry>
        </collision>
        <visual name="bottom_visual">
          <pose>0.10 0 -0.415 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
        <collision name="tip_collision">
          <pose>0.14 0 -0.355 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.12</length></cylinder></geometry>
        </collision>
        <visual name="tip_visual">
          <pose>0.14 0 -0.355 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="hook_c">
      <static>true</static>
      <pose>1.1 0 0 0 0 3.14159</pose>
      <link name="gantungan">
        <collision name="mount_collision">
          <pose>0.03 0 0.10 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.06</length></cylinder></geometry>
        </collision>
        <visual name="mount_visual">
          <pose>0.03 0 0.10 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
        <collision name="riser_collision">
          <pose>0.06 0 -0.1575 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.515</length></cylinder></geometry>
        </collision>
        <visual name="riser_visual">
          <pose>0.06 0 -0.1575 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.515</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
        <collision name="bottom_collision">
          <pose>0.10 0 -0.415 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.08</length></cylinder></geometry>
        </collision>
        <visual name="bottom_visual">
          <pose>0.10 0 -0.415 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
        <collision name="tip_collision">
          <pose>0.14 0 -0.355 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.12</length></cylinder></geometry>
        </collision>
        <visual name="tip_visual">
          <pose>0.14 0 -0.355 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="hook_a">
      <static>true</static>
      <pose>0 -2.2 0 0 0 1.5708</pose>
      <link name="gantungan">
        <collision name="mount_collision">
          <pose>0.03 0 0.10 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.06</length></cylinder></geometry>
        </collision>
        <visual name="mount_visual">
          <pose>0.03 0 0.10 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
        <collision name="riser_collision">
          <pose>0.06 0 -0.1575 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.515</length></cylinder></geometry>
        </collision>
        <visual name="riser_visual">
          <pose>0.06 0 -0.1575 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.515</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
        <collision name="bottom_collision">
          <pose>0.10 0 -0.415 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.08</length></cylinder></geometry>
        </collision>
        <visual name="bottom_visual">
          <pose>0.10 0 -0.415 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
        <collision name="tip_collision">
          <pose>0.14 0 -0.355 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.12</length></cylinder></geometry>
        </collision>
        <visual name="tip_visual">
          <pose>0.14 0 -0.355 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="hook_b">
      <static>true</static>
      <pose>0 2.2 0 0 0 -1.5708</pose>
      <link name="gantungan">
        <collision name="mount_collision">
          <pose>0.03 0 0.10 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.06</length></cylinder></geometry>
        </collision>
        <visual name="mount_visual">
          <pose>0.03 0 0.10 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
        <collision name="riser_collision">
          <pose>0.06 0 -0.1575 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.515</length></cylinder></geometry>
        </collision>
        <visual name="riser_visual">
          <pose>0.06 0 -0.1575 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.515</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
        <collision name="bottom_collision">
          <pose>0.10 0 -0.415 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.08</length></cylinder></geometry>
        </collision>
        <visual name="bottom_visual">
          <pose>0.10 0 -0.415 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
        <collision name="tip_collision">
          <pose>0.14 0 -0.355 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.12</length></cylinder></geometry>
        </collision>
        <visual name="tip_visual">
          <pose>0.14 0 -0.355 0 0 0</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
