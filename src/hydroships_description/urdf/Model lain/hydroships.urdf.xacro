<?xml version="1.0"?>
<!--
  HYDROships ROV - model URDF/xacro untuk KKI 2026 (Milestone 1).

  Frame konvensi ROS (REP-103): x maju (surge), y kiri (sway), z atas (heave).

  Catatan penyederhanaan M1:
    * Visual tetap primitif (box/cylinder) supaya ringan; lihat
      rov_kki2026_new_design.urdf.xacro untuk versi bermesh CAD.
    * Koefisien hidrodinamika memakai nilai acuan tipe BlueROV2 (di-tune belakangan).

  DISINKRONKAN DENGAN CAD (2026-07-28)
    Dimensi, posisi/sumbu thruster, massa, inertia, dan volume collision kini
    diturunkan dari "DOKUMENTASI ROV/@ROV KKI 2026 NEW DESIGN.stl" lewat
    hydroships_description/scripts/measure_cad_frames.py, dan penomoran
    thruster mengikuti Gambar 2.9/2.10 dokumen desain (penulis, 2026).
    Model ini dan rov_kki2026_new_design.urdf.xacro kini memakai geometri
    thruster, massa, dan inertia yang IDENTIK — bedanya hanya visual
    (primitif vs mesh CAD). allocation.py sudah ikut disinkronkan.

    Volume collision SENGAJA jauh lebih kecil dari bbox: ROV ini rangka
    TERBUKA, air mengalir menembusnya, jadi volume air yang benar-benar
    tergeser hanya 0.006644 m^3 (bahan padat + rongga tabung enclosure),
    bukan 0.0508 m^3 seperti kotak penuh. Kotak collision di bawah disetel
    agar volumenya tepat sama dgn angka terukur itu, dan pusatnya 0.02 m di
    atas CoG supaya CoB > CoG (stabil). Konsekuensi: saat menyentuh dasar
    kolam, badan ROV akan tampak tenggelam sebagian ke lantai — itu harga
    dari apung yang benar. Lihat rov_kki2026_new_design.parts.md.

  PARAMETER FISIK TER-EKSTERNAL: massa, CoG/CoB, tensor inertia, & 18 koefisien
  hidrodinamika kini dibaca dari config/rov_params.yaml (via xacro.load_yaml)
  sehingga bisa diganti tanpa menyunting file ini. Semua masih ESTIMASI sampai
  data ukur ROV nyata dimasukkan; pakai scripts/estimate_mass_inertia.py untuk
  menurunkan massa & inertia dari geometri+material final. Lihat PROBLEM.md.

  Geometri & orientasi 6 thruster didokumentasikan di docs/thruster_config.md
  dan HARUS konsisten dengan tabel THRUSTERS di hydroships_control/thruster_allocator.py.
-->
<robot name="hydroships" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================ Parameter ============================ -->
  <!-- bbox ROV terukur dari CAD (m). -->
  <xacro:property name="body_x" value="0.5079"/>
  <xacro:property name="body_y" value="0.3469"/>
  <xacro:property name="body_z" value="0.2959"/>

  <!-- Kotak collision = volume air TERGESER terukur (0.006644 m^3), bukan bbox.
       Tebal = 0.006644 / (body_x * body_y). Pusat 0.02 m di atas CoG. -->
  <xacro:property name="cob_z" value="0.02"/>

  <!-- (bow_yaw dulu untuk memutar mesh; visual kini primitif dgn haluan tetap +X.) -->

  <!-- ===== Parameter FISIK dari config/rov_params.yaml =====================
       Massa, CoG/CoB, tensor inertia, & 18 koefisien hidrodinamika dipisah ke
       file YAML agar bisa diganti TANPA menyunting URDF ini. Semua masih
       ESTIMASI (placeholder box-geometri / BlueROV2-like) sampai data ukur ROV
       nyata tersedia — lihat rov_params.yaml & PROBLEM.md. Path relatif thd
       file xacro ini -> valid di layout sumber (src/.../urdf) & install
       (share/pkg/urdf), keduanya bersebelahan dgn .../config. -->
  <xacro:property name="rp" value="${xacro.load_yaml('../config/rov_params.yaml')}"/>

  <xacro:property name="vehicle_mass" value="${rp['vehicle_mass']}"/>
  <xacro:property name="displaced_volume" value="${rp['displaced_volume']}"/>
  <xacro:property name="thruster_mass" value="${rp['thruster_mass']}"/>

  <!-- Massa link tambahan model ini (gripper + 2 jari + 6 thruster). base_link
       mendapat sisanya, supaya massa TOTAL = vehicle_mass persis sama dengan
       rov_kki2026_new_design.urdf.xacro meski link tambahannya berbeda. -->
  <xacro:property name="grip_mass" value="0.12"/>
  <xacro:property name="finger_mass" value="0.06"/>
  <xacro:property name="aux_mass" value="${6*thruster_mass + grip_mass + 2*finger_mass}"/>
  <xacro:property name="base_mass" value="${vehicle_mass - aux_mass}"/>

  <!-- Volume collision link tambahan; dikurangkan dari kotak base_link supaya
       TOTAL volume collision = displaced_volume terukur. -->
  <xacro:property name="aux_volume" value="${0.10*0.10*0.06 + 2*(0.08*0.016*0.03)}"/>
  <xacro:property name="fluid_density" value="${rp['fluid_density']}"/>

  <xacro:property name="cog" value="${rp['cog']}"/>

  <!-- Tensor inertia base_link (kg*m^2) di CoG — dari YAML (dihitung oleh
       scripts/estimate_mass_inertia.py dari geometri box + massa). -->
  <xacro:property name="ixx" value="${rp['inertia']['ixx']}"/>
  <xacro:property name="iyy" value="${rp['inertia']['iyy']}"/>
  <xacro:property name="izz" value="${rp['inertia']['izz']}"/>
  <xacro:property name="ixy" value="${rp['inertia']['ixy']}"/>
  <xacro:property name="ixz" value="${rp['inertia']['ixz']}"/>
  <xacro:property name="iyz" value="${rp['inertia']['iyz']}"/>

  <!-- ============================ base_link ============================ -->
  <link name="base_link">
    <inertial>
      <origin xyz="${cog['x']} ${cog['y']} ${cog['z']}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
               iyy="${iyy}" iyz="${iyz}"
               izz="${izz}"/>
    </inertial>
    <!-- Visual: model SEDERHANA dari primitif (BUKAN mesh berat lagi).
         Sebelumnya pakai meshes/rov.stl (12 MB, ~237k segitiga hasil konversi FBX)
         yang bentuknya acak-acak & bikin rate kamera turun ~22→10 Hz (lihat PROBLEM.md).
         Diganti susunan box/cylinder ringan bergaya BlueROV Heavy:
           - rangka kotak HITAM (bagian bawah)
           - busa apung ORANYE (bagian atas)
           - tabung elektronik abu-abu + dome kamera depan (penanda haluan +X)
         Total tetap mengisi bbox desain 0.345 x 0.345 x 0.286 m; bow = +X (arah surge).
         Collision TETAP kotak (untuk fisika/buoyancy) — tak diubah. -->

    <!-- Rangka utama (hitam) — bagian bawah badan. -->
    <visual>
      <origin xyz="0 0 -0.0465" rpy="0 0 0"/>
      <geometry>
        <box size="0.345 0.345 0.193"/>
      </geometry>
      <material name="hydro_frame_black">
        <color rgba="0.10 0.10 0.11 1.0"/>
      </material>
    </visual>

    <!-- Busa apung (oranye) — blok di atas, sedikit inset dari rangka. -->
    <visual>
      <origin xyz="0 0 0.0965" rpy="0 0 0"/>
      <geometry>
        <box size="0.315 0.335 0.093"/>
      </geometry>
      <material name="hydro_orange">
        <color rgba="0.95 0.45 0.05 1.0"/>
      </material>
    </visual>

    <!-- Tabung elektronik (abu-abu) — silinder membujur sumbu X di tengah badan. -->
    <visual>
      <origin xyz="0.0 0 0.005" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.058" length="0.30"/>
      </geometry>
      <material name="hydro_grey">
        <color rgba="0.55 0.55 0.58 1.0"/>
      </material>
    </visual>

    <!-- Dome kamera depan (abu gelap) — penanda haluan (+X). -->
    <visual>
      <origin xyz="0.175 0 0.005" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.02"/>
      </geometry>
      <material name="hydro_dome">
        <color rgba="0.15 0.15 0.18 1.0"/>
      </material>
    </visual>
    <!-- Collision box dipakai plugin Buoyancy untuk menghitung volume perpindahan.
         Ukurannya = volume tergeser terukur, BUKAN bbox (lihat header). -->
    <collision>
      <origin xyz="0 0 ${cob_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_x} ${body_y} ${(displaced_volume - aux_volume) / (body_x * body_y)}"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== Macro satu thruster ==================== -->
  <!--
    name  : nama unik thruster (mis. thruster_1)
    xyz   : posisi pusat thruster di frame body
    axis  : arah dorong (unit vector) di frame body; juga sumbu putar propeller
  -->
  <xacro:macro name="thruster" params="name xyz axis visual_rpy='0 0 0' visual_offset='0 0 0'">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${thruster_mass}"/>
        <inertia ixx="1e-4" ixy="0.0" ixz="0.0"
                 iyy="1e-4" iyz="0.0" izz="1e-4"/>
      </inertial>
      <visual>
        <origin xyz="${visual_offset}" rpy="${visual_rpy}"/>
        <geometry>
          <cylinder radius="0.012" length="0.05"/>
        </geometry>
        <material name="hydro_dark">
          <color rgba="0.1 0.1 0.12 1.0"/>
        </material>
      </visual>
      <visual>
        <origin xyz="${visual_offset}" rpy="${visual_rpy}"/>
        <geometry>
          <cylinder radius="0.024" length="0.008"/>
        </geometry>
        <material name="hydro_yellow">
          <color rgba="0.9 0.75 0.1 1.0"/>
        </material>
      </visual>
      <!-- Tanpa collision: thruster tidak menambah volume apung. -->
    </link>

    <!-- Continuous joint: propeller berputar; plugin Thruster memberi gaya
         sepanjang sumbu joint (= arah dorong). -->
    <joint name="${name}_joint" type="continuous">
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${name}"/>
      <axis xyz="${axis}"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
  </xacro:macro>

    <!-- ==================== Thruster positions (TERUKUR dari CAD) ==========
         Posisi & sumbu diukur dari @ROV KKI 2026 NEW DESIGN.stl via
         scripts/measure_cad_frames.py; penomoran mengikuti Gambar 2.9/2.10
         dokumen desain (penulis, 2026). HARUS konsisten dgn
         hydroships_control/allocation.py (THRUSTERS) dan docs/thruster_config.md.

           nama        peran               kelas  duct terukur
           thruster_1  surge kanan         T200   duct 90.1 mm
           thruster_2  surge kiri          T200   duct 90.1 mm
           thruster_3  heave haluan kanan  T100   prop 66.6 mm
           thruster_4  heave haluan kiri   T100   prop 66.6 mm
           thruster_5  heave buritan       T100   prop 66.6 mm
           thruster_6  sway tengah-bawah   T100   prop 59.0 mm

         Mapping LAMA menukar peran pasangan haluan <-> tengah (1,2 dikira
         vertikal, 3,4 surge) dan menukar 5 <-> 6. CAD & Gambar 2.9 keduanya
         menunjukkan sebaliknya. Setelah koreksi, cond(TAM) 19.7 -> 10.0 dan
         gaya thruster utk wrench satuan pada DOF terlemah 9.25 N -> 4.06 N.

         Arah putar propeller (Gambar 2.9): 1=CCW 2=CW 3=CCW 4=CW 5=CW 6=CCW
         — tiap pasangan berlawanan agar torsi reaksi saling meniadakan.
         Tanda sumbu masih perlu verifikasi bench (lihat allocation.py).
         Catatan: visual_rpy/visual_offset hanya kosmetik. -->
    <xacro:thruster name="thruster_1" xyz="-0.0291 -0.1188 0.0186" axis="1.0 0.0 0.0" visual_rpy="0 1.5708 0" visual_offset="0.008 0 0"/>
    <xacro:thruster name="thruster_2" xyz="-0.0287 0.1274 0.0190"  axis="1.0 0.0 0.0" visual_rpy="0 1.5708 0" visual_offset="0.008 0 0"/>
    <xacro:thruster name="thruster_3" xyz="0.1050 -0.1332 0.0592"  axis="0.0 0.0 1.0" visual_rpy="0 0 0"      visual_offset="0 0 0.008"/>
    <xacro:thruster name="thruster_4" xyz="0.1053 0.1411 0.0550"   axis="0.0 0.0 1.0" visual_rpy="0 0 0"      visual_offset="0 0 0.008"/>
    <xacro:thruster name="thruster_5" xyz="-0.1610 0.0037 0.0621"  axis="0.0 0.0 1.0" visual_rpy="0 0 0"      visual_offset="0 0 0.008"/>
    <xacro:thruster name="thruster_6" xyz="-0.0700 0.0200 -0.0939" axis="0.0 1.0 0.0" visual_rpy="1.5708 0 0" visual_offset="0 0.008 0"/>

  <!-- ==================== Frame sensor (placeholder M3) ==================== -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <link name="depth_link"/>
  <joint name="depth_joint" type="fixed">
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="depth_link"/>
  </joint>

  <link name="camera_front_link"/>
  <joint name="camera_front_joint" type="fixed">
    <origin xyz="${body_x/2} 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_front_link"/>
  </joint>

  <link name="camera_bottom_link"/>
  <joint name="camera_bottom_joint" type="fixed">
    <!-- Sedikit DI BAWAH sisi bawah mesh (z=-0.143) agar pandangan ke bawah tidak
         terhalang badan ROV sendiri; port kamera bawah menghadap dasar kolam. -->
    <origin xyz="0.02 0 -0.18" rpy="0 1.5708 0"/>
    <parent link="base_link"/>
    <child link="camera_bottom_link"/>
  </joint>

  <!-- ==================== Sensor Gazebo (Milestone 3) ==================== -->
  <!-- Butuh sistem gz-sim-imu-system & gz-sim-sensors-system di world (lihat
       hydroships_gazebo/worlds/*.sdf). Depth TIDAK dari sensor di sini melainkan
       diturunkan dari /hydroships/odom oleh node depth_publisher (z -> kedalaman). -->

  <!-- IMU pada imu_link -> gz topic /hydroships/imu (gz.msgs.IMU). -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <topic>hydroships/imu</topic>
    </sensor>
  </gazebo>

  <!-- Kamera depan (haluan, menghadap +x) -> /hydroships/camera_front/image. -->
  <gazebo reference="camera_front_link">
    <sensor name="camera_front" type="camera">
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <topic>hydroships/camera_front/image</topic>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>20.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Kamera bawah (menghadap dasar kolam / QR) -> /hydroships/camera_bottom/image. -->
  <gazebo reference="camera_bottom_link">
    <sensor name="camera_bottom" type="camera">
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <topic>hydroships/camera_bottom/image</topic>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>20.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ==================== Manipulator (rancang ulang M5) ====================
       Grasp FISIK memakai gz-sim DetachableJoint (sambungan kaku ROV<->payload),
       BUKAN gesekan jari. DUA JARI opposing (kiri/kanan) di sini KOSMETIK
       (indikator visual buka/tutup) — digerakkan SEREMPAK dari satu nilai sudut.
       Dipasang di MUKA DEPAN ROV, menjorok ke arah depan (+X). Lihat PROBLEM.md. -->
  <!-- Body gripper di muka depan ROV, menjorok ke depan (+X). -->
  <link name="gripper_base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${grip_mass}"/>
      <inertia ixx="1.4e-4" ixy="0.0" ixz="0.0" iyy="1.4e-4" iyz="0.0" izz="2.0e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.10 0.06"/></geometry>
      <material name="hydro_grip"><color rgba="0.85 0.7 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.10 0.06"/></geometry>
    </collision>
  </link>
  <joint name="gripper_base_joint" type="fixed">
    <origin xyz="0.18 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="gripper_base"/>
  </joint>

  <!-- Cegah sdformat melebur gripper_base ke base_link saat URDF->SDF: DetachableJoint
       plugin butuh link ini tetap berdiri sendiri di SDF (parent_link). preserveFixedJoint
       menahan joint fixed jadi joint SDF nyata (kinematika kaku tetap sama). Catatan: di
       Fortress <disableFixedJointLumping> pada link TIDAK cukup bila base_link punya
       banyak child fixed-joint lain (imu/kamera) — link tetap ter-lump; preserveFixedJoint
       pada joint bekerja andal. dontcollapse TIDAK dikenali. Lihat docs/CHANGELOG.md. -->
  <gazebo reference="gripper_base_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- Dua jari opposing (masing-masing 1 DOF revolute, sumbu Z) -> menjepit di
       bidang XY seperti parallel gripper pada umumnya. Kosmetik: menandai
       buka/tutup. Sudut 0 = TERTUTUP (kedua jari sejajar menghadap +X); sudut
       naik = MEMBUKA (tip menjauh dari sumbu tengah). Mirroring diurus tanda
       axis (kiri 0 0 -1, kanan 0 0 1) sehingga nilai Float64 yang SAMA dikirim
       ke kedua joint dan gerakannya otomatis simetris. -->
  <xacro:macro name="gripper_finger" params="side y_pivot axis_z">
    <link name="gripper_finger_${side}">
      <inertial>
        <origin xyz="0.04 0 0" rpy="0 0 0"/>
        <mass value="${finger_mass}"/>
        <inertia ixx="6.0e-6" ixy="0.0" ixz="0.0" iyy="3.6e-5" iyz="0.0" izz="3.4e-5"/>
      </inertial>
      <visual>
        <origin xyz="0.04 0 0" rpy="0 0 0"/>
        <geometry><box size="0.08 0.016 0.03"/></geometry>
        <material name="hydro_jaw"><color rgba="0.95 0.8 0.2 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0.04 0 0" rpy="0 0 0"/>
        <geometry><box size="0.08 0.016 0.03"/></geometry>
      </collision>
    </link>
    <joint name="gripper_${side}_joint" type="revolute">
      <origin xyz="0.04 ${y_pivot} 0" rpy="0 0 0"/>
      <parent link="gripper_base"/>
      <child link="gripper_finger_${side}"/>
      <axis xyz="0 0 ${axis_z}"/>
      <limit lower="-0.1" upper="0.5" effort="10.0" velocity="2.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:gripper_finger side="left"  y_pivot="-0.025" axis_z="-1"/>
  <xacro:gripper_finger side="right" y_pivot="0.025"  axis_z="1"/>

  <!-- ============================================================ -->
  <!-- ===================  Plugin Gazebo Fortress  =============== -->
  <!-- ============================================================ -->

  <!-- Hydrodynamics (added-mass + drag Fossen) pada base_link.
       SEMUA koefisien dibaca dari config/rov_params.yaml (added_mass,
       linear_damping, quadratic_damping) — placeholder tipe BlueROV2, ganti
       dgn data identifikasi nyata di YAML tanpa menyunting URDF ini. -->
  <xacro:property name="am" value="${rp['added_mass']}"/>
  <xacro:property name="ld" value="${rp['linear_damping']}"/>
  <xacro:property name="qd" value="${rp['quadratic_damping']}"/>
  <gazebo>
    <plugin filename="gz-sim-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>${fluid_density}</water_density>
      <!-- Added mass -->
      <xDotU>${am['xDotU']}</xDotU>
      <yDotV>${am['yDotV']}</yDotV>
      <zDotW>${am['zDotW']}</zDotW>
      <kDotP>${am['kDotP']}</kDotP>
      <mDotQ>${am['mDotQ']}</mDotQ>
      <nDotR>${am['nDotR']}</nDotR>
      <!-- Linear damping -->
      <xU>${ld['xU']}</xU>
      <yV>${ld['yV']}</yV>
      <zW>${ld['zW']}</zW>
      <kP>${ld['kP']}</kP>
      <mQ>${ld['mQ']}</mQ>
      <nR>${ld['nR']}</nR>
      <!-- Quadratic damping -->
      <xUabsU>${qd['xUabsU']}</xUabsU>
      <yVabsV>${qd['yVabsV']}</yVabsV>
      <zWabsW>${qd['zWabsW']}</zWabsW>
      <kPabsP>${qd['kPabsP']}</kPabsP>
      <mQabsQ>${qd['mQabsQ']}</mQabsQ>
      <nRabsR>${qd['nRabsR']}</nRabsR>
    </plugin>
  </gazebo>

  <!-- Odometry publisher: gz topic /model/hydroships/odometry (gz.msgs.Odometry). -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- Satu plugin Thruster per propeller.
       Perintah gaya (N) dikirim ke topic gz: hydroships/thruster_i/thrust (gz.msgs.Double). -->
  <xacro:macro name="thruster_plugin" params="name diameter">
    <gazebo>
      <plugin filename="gz-sim-thruster-system"
              name="gz::sim::systems::Thruster">
        <namespace>hydroships</namespace>
        <joint_name>${name}_joint</joint_name>
        <!-- namespace 'hydroships' di-prepend oleh plugin, jadi topic TANPA prefix
             'hydroships/' -> subscribe ke /hydroships/${name}/thrust (cocok bridge).
             Sebelumnya /hydroships/hydroships/... sehingga thrust TAK PERNAH masuk. -->
        <topic>${name}/thrust</topic>
        <use_angvel_cmd>false</use_angvel_cmd>
        <fluid_density>${fluid_density}</fluid_density>
        <propeller_diameter>${diameter}</propeller_diameter>
        <thrust_coefficient>0.004422</thrust_coefficient>
        <max_thrust_cmd>50.0</max_thrust_cmd>
        <min_thrust_cmd>-40.0</min_thrust_cmd>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- Diameter mengikuti KELAS hasil ukur CAD: T200 (surge) duct 90 mm ->
       0.076 m; T100 (heave & sway) prop 66.6 mm -> 0.048 m. Sebelumnya
       pembagian 0.076/0.048 mengikuti nomor urut, bukan kelas, sehingga
       dua unit identik bisa dapat diameter berbeda. -->
  <xacro:thruster_plugin name="thruster_1" diameter="0.076"/>  <!-- T200 surge -->
  <xacro:thruster_plugin name="thruster_2" diameter="0.076"/>  <!-- T200 surge -->
  <xacro:thruster_plugin name="thruster_3" diameter="0.048"/>  <!-- T100 heave -->
  <xacro:thruster_plugin name="thruster_4" diameter="0.048"/>  <!-- T100 heave -->
  <xacro:thruster_plugin name="thruster_5" diameter="0.048"/>  <!-- T100 heave -->
  <xacro:thruster_plugin name="thruster_6" diameter="0.048"/>  <!-- T100 sway  -->

  <!-- ============ Plugin manipulator (rancang ulang M5) ============ -->
  <!-- Kontrol posisi dua jari kosmetik: target sudut (rad) via gz.msgs.Double di
       /hydroships/gripper_left/cmd & /hydroships/gripper_right/cmd (dijembatani
       dari ROS Float64). Satu instance plugin per joint (cara standar Fortress);
       nilai yang dikirim identik, mirroring dari tanda axis di URDF. -->
  <xacro:macro name="gripper_finger_plugin" params="side">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>gripper_${side}_joint</joint_name>
        <topic>/hydroships/gripper_${side}/cmd</topic>
        <p_gain>2.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>0.1</d_gain>
      </plugin>
    </gazebo>
  </xacro:macro>
  <xacro:gripper_finger_plugin side="left"/>
  <xacro:gripper_finger_plugin side="right"/>

  <!-- GRASP FISIK: DetachableJoint membuat sambungan kaku gripper_base<->payload.
       attach saat pesan di /hydroships/gripper/attach, detach di .../detach
       (gz.msgs.Empty, dijembatani dari ROS std_msgs/Empty).
       child_model 'payload' = model braket-L di hydroships_gazebo/worlds/kki_arena.sdf
       (kini non-static agar bisa diangkat).
       CATATAN penting: gz-sim Fortress SELALU meng-attach saat load (perilaku default
       DetachableJoint; tak ada cara menahannya lewat SDF — <suppress_initial_attach>
       TIDAK valid di Fortress, <initial_attach> baru diusulkan PR gz-sim #3268 utk
       gz-sim10). Kondisi attached bawaan itu DILEPAS oleh gripper_controller yang
       menerbitkan satu pesan detach otomatis saat startup node (lihat PROBLEM.md
       "Ketergantungan versi gz-sim Fortress" [RESOLVED]). -->
  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>gripper_base</parent_link>
      <child_model>payload</child_model>
      <child_link>payload_link</child_link>
      <attach_topic>/hydroships/gripper/attach</attach_topic>
      <detach_topic>/hydroships/gripper/detach</detach_topic>
    </plugin>
  </gazebo>

</robot>
